# better-spend-limits — environment reference.
#
# Copy to `.env` (gitignored) for docker-compose.prod.yml, or to
# `apps/web/.env.local` (gitignored) to override the checked-in development
# defaults when running from source.
#
# ─────────────────────────────────────────────────────────────────────────────
#  READ THIS FIRST
#
#  A real environment variable BEATS every .env file. Next.js gives
#  `process.env` precedence over `.env.development`, so if your shell profile
#  exports ANTHROPIC_BASE_URL (a common thing to have around if you also use the
#  Claude API), `npm run dev` silently points this app at api.anthropic.com even
#  though apps/web/.env.development says localhost. Reads then fail with 401 —
#  but the edit-limit and approve/deny flows would write to a REAL organization.
#
#  Check the value the app actually resolved before doing anything destructive:
#
#      node -e 'console.log(process.env.ANTHROPIC_BASE_URL ?? "(unset)")'
#
#  If that prints anything other than "(unset)" or a localhost URL, either
#  `unset ANTHROPIC_BASE_URL` or start the app with an explicit override:
#
#      ANTHROPIC_BASE_URL=http://localhost:8787 npm run dev
# ─────────────────────────────────────────────────────────────────────────────


# ─── apps/web ────────────────────────────────────────────────────────────────

# The Anthropic API root. Leave unset in production to use the default.
# Local demo: http://localhost:8787 (the mock). Default: https://api.anthropic.com
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Admin API key, scopes `read:spend_limits` and `write:spend_limits`.
# This key can change spend limits and approve increase requests for the entire
# organization. Treat it as a production credential.
ANTHROPIC_ADMIN_KEY=

# Analytics API key, scope `read:analytics`. A SEPARATE key from the Admin key —
# the two are not interchangeable and the API rejects the wrong one.
ANTHROPIC_ANALYTICS_KEY=

# `dev`   — impersonation cookie plus the user switcher in the sidebar. No
#           authentication whatsoever. Local demos only.
# `proxy` — trust the email in AUTH_HEADER, set by your SSO reverse proxy.
#           Anything that can reach the app directly can forge that header, so
#           the app must not be reachable except through the proxy.
AUTH_MODE=proxy

# Which header carries the authenticated email in proxy mode.
AUTH_HEADER=x-forwarded-email

# Dev mode only: who a visitor with no impersonation cookie becomes, so a fresh
# clone opens on a populated page instead of the "not provisioned" 403. A cookie
# always wins, including one that names nobody. Left commented out because
# AUTH_MODE above is `proxy`, and setting both is a startup error by design —
# uncomment it only in a file that also sets AUTH_MODE=dev.
# DEV_DEFAULT_EMAIL=theo.delacroix@example.com

# SQLite file. Relative paths resolve against the working directory, which is
# apps/web for every command that opens the database. In Docker: /data/app.db.
DATABASE_PATH=./data/app.db


# ─── apps/mock-api (local demos only; never deployed) ────────────────────────

# Port the mock listens on.
PORT=8787

# Keys the mock accepts. They must match ANTHROPIC_ADMIN_KEY /
# ANTHROPIC_ANALYTICS_KEY above when you point the app at the mock.
MOCK_ADMIN_KEY=mock-admin-key
MOCK_ANALYTICS_KEY=mock-analytics-key

# Seed for the synthetic organization. 42 is the one every test fixture refers
# to; change it to demo a different 250-person org.
MOCK_SEED=42

# `off`, or a number of requests per minute. The real API allows 60/min per org
# across all endpoints; set a number to rehearse what hitting that looks like.
MOCK_RATE_LIMIT=off
