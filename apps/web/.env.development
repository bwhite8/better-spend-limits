# Checked-in development defaults (§G6). Everything here points at the local
# mock API, so `npm run dev` works on a fresh clone with no secrets.
#
# Put real credentials in `.env.local` (gitignored), never here.

ANTHROPIC_BASE_URL=http://localhost:8787
ANTHROPIC_ADMIN_KEY=mock-admin-key
ANTHROPIC_ANALYTICS_KEY=mock-analytics-key

AUTH_MODE=dev
AUTH_HEADER=x-forwarded-email

DATABASE_PATH=./data/app.db
