# Checked-in development defaults (§G6). Everything here points at the local
# mock API, so `npm run dev` works on a fresh clone with no secrets.
#
# Put real credentials in `.env.local` (gitignored), never here.

ANTHROPIC_BASE_URL=http://localhost:8787
ANTHROPIC_ADMIN_KEY=mock-admin-key
ANTHROPIC_ANALYTICS_KEY=mock-analytics-key

AUTH_MODE=dev
AUTH_HEADER=x-forwarded-email

# Who a visitor with no impersonation cookie becomes, so a fresh clone lands on
# a working app instead of the "not provisioned" 403. Dev mode only — the app
# refuses to start if this is set alongside AUTH_MODE=proxy. Pick anyone from
# the switcher and the cookie takes over from here.
DEV_DEFAULT_EMAIL=theo.delacroix@example.com

DATABASE_PATH=./data/app.db
