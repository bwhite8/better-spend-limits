# syntax=docker/dockerfile:1
#
# apps/web — the Next.js UI and its BFF routes.
#
# Deliberately a single stage rather than a `next build --standalone` slim
# image. The container also has to run `drizzle-kit migrate` (a devDependency)
# and, in the demo profile, `tsx src/db/seed.ts`, so the toolchain has to survive
# into the runtime layer anyway. The result is a larger image in exchange for a
# build that has no way to drift from `npm run build` on a laptop.
#
# Debian rather than Alpine: better-sqlite3's prebuilt binaries are glibc, and
# so is the source build the toolchain layer below exists to allow.

FROM node:22-bookworm-slim

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# better-sqlite3 ships a prebuilt `linux-x64` binary and sets `"gypfile": false`
# to tell npm not to build it, but the npm bundled with this image runs
# `node-gyp rebuild` for it regardless — which fails on a slim image with no
# Python, taking the whole build with it. Installing the toolchain lets that
# build succeed instead of betting on the heuristic. Runs as root, before the
# USER switch below.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

# /data is the SQLite volume. Creating it in the image with `node` ownership is
# what makes a fresh named volume writable by the unprivileged user.
RUN mkdir -p /app /data && chown -R node:node /app /data
USER node
WORKDIR /app

COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node apps/web/package.json apps/web/
COPY --chown=node:node apps/mock-api/package.json apps/mock-api/
COPY --chown=node:node packages/shared/package.json packages/shared/
COPY --chown=node:node packages/seed/package.json packages/seed/

RUN npm ci --include=dev

COPY --chown=node:node . .

RUN npm run build -w apps/web

# §G6. Note there are NO default API credentials: an image that ships with a key
# baked in is an image someone eventually deploys with it.
ENV NODE_ENV=production \
    PORT=3000 \
    DATABASE_PATH=/data/app.db \
    AUTH_MODE=dev \
    AUTH_HEADER=x-forwarded-email

VOLUME ["/data"]
EXPOSE 3000

# Migrations run on every start: they are idempotent, and the volume may be
# older than the image. Seeding is NOT here — that is a demo-only step the
# compose file adds, because a production roster arrives via the admin CSV
# import, not from the synthetic generator.
CMD ["sh", "-c", "npm run db:migrate && npm run start -w apps/web"]
